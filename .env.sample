# The secret key
SECRET_KEY=secret_key

# Storage settings

# SQLite storage
STORAGE_BACKEND=fuelpricesgr.storage.sql_alchemy.SqlAlchemyStorage
# PostgreSQL storage
#STORAGE_BACKEND=fuelpricesgr.storage.sql_alchemy.SqlAlchemyStorage
#STORAGE_URL=postgresql+psycopg://fuelpricesgr:fuelpricesgr@localhost/fuelpricesgr
# MySQL/MariaDB storage
#STORAGE_BACKEND=fuelpricesgr.storage.sql_alchemy.SqlAlchemyStorage
#STORAGE_URL=mysql+pymysql://fuelpricesgr:fuelpricesgr@localhost/fuelpricesgr?charset=utf8mb4
# MongoDB storage
#STORAGE_BACKEND=fuelpricesgr.storage.mongo.MongoDBStorage
#STORAGE_URL=mongodb://fuelpricesgr:fuelpricesgr@localhost/fuelpricesgr

# Set to true in order to display the running SQL queries for the SQLAlchemy back end
SHOW_SQL=False

# The CORS settings
CORS_ALLOW_ORIGINS=http://localhost:5173
